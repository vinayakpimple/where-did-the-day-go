{
  "name": "wheredidthedaygo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "copy:cesium": "node scripts/copy-cesium.mjs",
    "postinstall": "node scripts/copy-cesium.mjs",
    "dev": "node scripts/copy-cesium.mjs && next dev",
    "build": "node scripts/copy-cesium.mjs && node scripts/expand-messages.mjs && node scripts/validate-messages.mjs && node scripts/gen-sitemap-index.mjs && next build",
    "start": "next start",
    "check:cities": "node --experimental-strip-types scripts/validate-cities.ts",
    "check": "node scripts/validate-messages.mjs",
    "bundle:messages": "node scripts/bundle-messages.mjs"
  },
  "dependencies": {
    "cesium": "^1.137.0",
    "next": "^15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "sharp": "^0.35.3",
    "typescript": "5.7.2"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.35.3": true
  }
}
